# ============================================================
#  Bâti-Pro : réglages du serveur (hébergeur Apache ou LiteSpeed)
#  Ce fichier est ignoré par GitHub Pages.
# ============================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------- HTTPS obligatoire ----------
# Activez d'abord le certificat SSL chez l'hébergeur : sans lui, cette redirection bloque le site.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- Fichiers privés : jamais servis ----------
# Fichiers cachés (.htaccess, état d'envoi FTP...), documents .md, configurations.
<FilesMatch "(^\.|\.(md|ya?ml|env|log|ini|sh|bak|sql)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------- En-têtes de sécurité ----------
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header unset X-Powered-By

  # Pages, données, scripts et styles : toujours la dernière version après une publication
  <FilesMatch "\.(html|json|xml|txt|js|css)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Photos et polices : gardées 30 jours (les nouvelles photos ont toujours un nouveau nom)
  <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # L'admin : jamais dans un cadre, jamais en cache, jamais dans Google
  <Files "admin.html">
    Header always set X-Frame-Options "DENY"
    Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
    Header set Cache-Control "no-store"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Referrer-Policy "no-referrer"
  </Files>
</IfModule>

# Réglage propre aux serveurs LiteSpeed : pas de cache de pages côté serveur
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

# ---------- Types de fichiers ----------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddCharset utf-8 .html .css .js .json .xml .txt
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
